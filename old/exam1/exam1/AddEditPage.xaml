<Page x:Class="exam1.AddEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:exam1"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddEditPage">

    <Grid Background="#F4E8D3">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <TextBlock Text="Продукт" Grid.Row="0"></TextBlock>
        <TextBlock Text="Партнёр" Grid.Row="1"></TextBlock>
        <TextBlock Text="Цена" Grid.Row="2"></TextBlock>
        <TextBlock Text="Дата" Grid.Row="3"></TextBlock>
        <ComboBox SelectedItem="{Binding Products}" Grid.Column="1" Grid.Row="0" x:Name="ComboProducts" DisplayMemberPath="ProductsName"></ComboBox>
        <ComboBox SelectedItem="{Binding Partners}" Grid.Column="1" Grid.Row="1" x:Name="ComboPartners" DisplayMemberPath="PartnersName"></ComboBox>
        <TextBox Text="{Binding PartnersProductsQuantity}" Grid.Column="1" Grid.Row="2"></TextBox>
        <DatePicker SelectedDate="{Binding PartnersProductsDate}" Grid.Column="1" Grid.Row="3" HorizontalAlignment="Stretch" VerticalAlignment="Center"></DatePicker>
        <Button Content="Сохранить" Grid.ColumnSpan="2" Grid.Row="5" Name="BtnSave" Click="BtnSave_Click"></Button>
    </Grid>
</Page>
