<Page x:Class="exam4.PurchasesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:exam4"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PurchasesPage" IsVisibleChanged="Page_IsVisibleChanged">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="377*"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
        </Grid.RowDefinitions>
        <DataGrid x:Name="DGridPurchases" AutoGenerateColumns="False" IsReadOnly="True" Background="#F4E8D3">
            <DataGrid.Columns>
                <DataGridTextColumn Width="*" Header="Продукт" Binding="{Binding Products.ProductsName}"></DataGridTextColumn>
                <DataGridTextColumn Width="*" Header="Партнёр" Binding="{Binding Partners.PartnersName}"></DataGridTextColumn>
                <DataGridTextColumn Width="*" Header="Количество товара" Binding="{Binding PurchasesQuantity}"></DataGridTextColumn>
                <DataGridTextColumn Width="*" Header="Дата" Binding="{Binding PurchasesDate}"></DataGridTextColumn>
                <DataGridTemplateColumn Width="auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Name="BtnEdit" Content="Редактировать" Click="BtnEdit_Click"></Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Button Content="Добавить" Name="BtnAdd" HorizontalAlignment="Left" Grid.Row="2" VerticalAlignment="Center" Click="BtnAdd_Click"></Button>
        <Button Content="Удалить" Name="BtnDelete" HorizontalAlignment="Right" Grid.Row="2" VerticalAlignment="Center" Click="BtnDelete_Click"></Button>
    </Grid>
</Page>
