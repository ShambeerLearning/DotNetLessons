<Page x:Class="examnet.PartnersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:examnet"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PartnersPage" IsVisibleChanged="Page_IsVisibleChanged">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <DataGrid x:Name="DGridPartners" AutoGenerateColumns="False" IsReadOnly="True" Background="#F4E8D3">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название партнера" Binding="{Binding PartnersName}" Width="*"></DataGridTextColumn>
                <DataGridTextColumn Header="Имя директора" Binding="{Binding PartnersCeoName}" Width="*"></DataGridTextColumn>
                <DataGridTextColumn Header="Адрес партнёра" Binding="{Binding PartnersAddress}" Width="*"></DataGridTextColumn>
                <DataGridTextColumn Header="Рейтинг партнера" Binding="{Binding PartnersRaiting}" Width="*"></DataGridTextColumn>
                <DataGridTemplateColumn Width="auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Редактировать" Name="BtnEdit" Click="BtnEdit_Click"></Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Button Name="BtnAdd" Content="Добавить" Grid.Row="1" HorizontalAlignment="Left" Click="BtnAdd_Click"></Button>
        <Button Name="BtnDelete" Content="Удалить" Grid.Row="1" HorizontalAlignment="Right" Click="BtnDelete_Click"></Button>
    </Grid>
</Page>
