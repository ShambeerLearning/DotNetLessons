<Page x:Class="examnet.AddEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:examnet"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddEditPage">

    <Grid Background="#FFCCC7C7">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource TextBlockEditAndAdd}" Text="Тип партнёра" Grid.Row="0"></TextBlock>
        <TextBlock Style="{StaticResource TextBlockEditAndAdd}" Text="Имя партнёра" Grid.Row="1"></TextBlock>
        <TextBlock Style="{StaticResource TextBlockEditAndAdd}" Text="Имя директора партнёра" Grid.Row="2"></TextBlock>
        <TextBlock Style="{StaticResource TextBlockEditAndAdd}" Text="Почта партнёра" Grid.Row="3"></TextBlock>
        <TextBlock Style="{StaticResource TextBlockEditAndAdd}" Text="Номер партнёра" Grid.Row="4"></TextBlock>
        <TextBlock Style="{StaticResource TextBlockEditAndAdd}" Text="Адрес партнёра" Grid.Row="5"></TextBlock>
        <TextBlock Style="{StaticResource TextBlockEditAndAdd}" Text="Инн партнёра" Grid.Row="6"></TextBlock>
        <TextBlock Style="{StaticResource TextBlockEditAndAdd}" Text="Рейтинг партнёра" Grid.Row="7"></TextBlock>
        <TextBox Style="{StaticResource TextBoxEditAndAdd}" Text="{Binding PartnersType}" MaxLength="3" Grid.Column="1" Grid.Row="0"></TextBox>
        <TextBox Style="{StaticResource TextBoxEditAndAdd}" Text="{Binding PartnersName}" MaxLength="255" Grid.Column="1" Grid.Row="1"></TextBox>
        <TextBox Style="{StaticResource TextBoxEditAndAdd}" Text="{Binding PartnersCeoName}" MaxLength="255" Grid.Column="1" Grid.Row="2"></TextBox>
        <TextBox Style="{StaticResource TextBoxEditAndAdd}" Text="{Binding PartnersEmail}" MaxLength="255" Grid.Column="1" Grid.Row="3"></TextBox>
        <TextBox Style="{StaticResource TextBoxEditAndAdd}" Text="{Binding PartnersNumber}" MaxLength="20" Grid.Column="1" Grid.Row="4"></TextBox>
        <TextBox Style="{StaticResource TextBoxEditAndAdd}" Text="{Binding PartnersAddress}" MaxLength="255" Grid.Column="1" Grid.Row="5"></TextBox>
        <TextBox Style="{StaticResource TextBoxEditAndAdd}" Text="{Binding PartnersInn}" MaxLength="12" Grid.Column="1" Grid.Row="6"></TextBox>
        <TextBox Style="{StaticResource TextBoxEditAndAdd}" Text="{Binding PartnersRaiting}" MaxLength="5" Grid.Column="1" Grid.Row="7"></TextBox>
        <Button Content="Сохранить" Grid.ColumnSpan="2" Grid.Row="8" Name="BtnSave" Click="BtnSave_Click"></Button>
    </Grid>
</Page>
