<Window x:Class="exam10.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:exam10"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
        </Grid.RowDefinitions>
        <Image Source="/Resources/Мастер пол.ico" HorizontalAlignment="Left"></Image>
        <TextBlock Text="Мастер пол" FontSize="30" VerticalAlignment="Center" HorizontalAlignment="Center"></TextBlock>
        <Frame NavigationUIVisibility="Hidden" x:Name="MainFrame" Grid.Row="1" ContentRendered="MainFrame_ContentRendered"></Frame>
        <Button Content="Вернуться" Name="BtnBack" VerticalAlignment="Center" HorizontalAlignment="Right" Click="BtnBack_Click"></Button>
    </Grid>
</Window>
