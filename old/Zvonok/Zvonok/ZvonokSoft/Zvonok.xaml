<Window x:Class="Zvonok.ZvonokSoft.Zvonok"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Zvonok.ZvonokSoft"
        mc:Ignorable="d"
        Title="Zvonok" Height="480" Width="400">
    <Grid Background="Wheat">
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="75"></RowDefinition>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Начало занятий" Margin="5" TextAlignment="Center"></TextBlock>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="25"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="1">
                            <TextBox Margin="5" Width="50"></TextBox>
                            <TextBox Margin="5" Width="50"></TextBox>
                            <TextBox Margin="5" Width="50"></TextBox>
                            <TextBox Margin="5" Width="50"></TextBox>
                            <TextBox Margin="5" Width="50"></TextBox>
                            <TextBox Margin="5" Width="50"></TextBox>
                            <TextBox Margin="5" Width="50"></TextBox>
                            <TextBox Margin="5" Width="50"></TextBox>
                            <TextBox Margin="5" Width="50"></TextBox>
                            <TextBox Margin="5" Width="50"></TextBox>
                            <TextBox Margin="5" Width="50"></TextBox>
                            <TextBox Margin="5" Width="50"></TextBox>
                            <TextBox Margin="5" Width="50"></TextBox>
                        </StackPanel>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="1." TextAlignment="Center" Margin="5"></TextBlock>
                            <TextBlock Text="2." TextAlignment="Center" Margin="5"></TextBlock>
                            <TextBlock Text="3." TextAlignment="Center" Margin="5"></TextBlock>
                            <TextBlock Text="4." TextAlignment="Center" Margin="5"></TextBlock>
                            <TextBlock Text="5." TextAlignment="Center" Margin="5"></TextBlock>
                            <TextBlock Text="6." TextAlignment="Center" Margin="5"></TextBlock>
                            <TextBlock Text="7." TextAlignment="Center" Margin="5"></TextBlock>
                            <TextBlock Text="8." TextAlignment="Center" Margin="5"></TextBlock>
                            <TextBlock Text="9." TextAlignment="Center" Margin="5"></TextBlock>
                            <TextBlock Text="10." TextAlignment="Center" Margin="5"></TextBlock>
                            <TextBlock Text="11." TextAlignment="Center" Margin="5"></TextBlock>
                            <TextBlock Text="12." TextAlignment="Center" Margin="5"></TextBlock>
                            <TextBlock Text="13." TextAlignment="Center" Margin="5"></TextBlock>
                            <TextBlock Text="14." TextAlignment="Center" Margin="5"></TextBlock>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Конец занятий" Margin="5" TextAlignment="Center"></TextBlock>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="25"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="1">
                            <TextBox Margin="5" Width="50"></TextBox>
                            <TextBox Margin="5" Width="50"></TextBox>
                            <TextBox Margin="5" Width="50"></TextBox>
                            <TextBox Margin="5" Width="50"></TextBox>
                            <TextBox Margin="5" Width="50"></TextBox>
                            <TextBox Margin="5" Width="50"></TextBox>
                            <TextBox Margin="5" Width="50"></TextBox>
                            <TextBox Margin="5" Width="50"></TextBox>
                            <TextBox Margin="5" Width="50"></TextBox>
                            <TextBox Margin="5" Width="50"></TextBox>
                            <TextBox Margin="5" Width="50"></TextBox>
                            <TextBox Margin="5" Width="50"></TextBox>
                            <TextBox Margin="5" Width="50"></TextBox>
                        </StackPanel>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="1." TextAlignment="Center" Margin="5"></TextBlock>
                            <TextBlock Text="2." TextAlignment="Center" Margin="5"></TextBlock>
                            <TextBlock Text="3." TextAlignment="Center" Margin="5"></TextBlock>
                            <TextBlock Text="4." TextAlignment="Center" Margin="5"></TextBlock>
                            <TextBlock Text="5." TextAlignment="Center" Margin="5"></TextBlock>
                            <TextBlock Text="6." TextAlignment="Center" Margin="5"></TextBlock>
                            <TextBlock Text="7." TextAlignment="Center" Margin="5"></TextBlock>
                            <TextBlock Text="8." TextAlignment="Center" Margin="5"></TextBlock>
                            <TextBlock Text="9." TextAlignment="Center" Margin="5"></TextBlock>
                            <TextBlock Text="10." TextAlignment="Center" Margin="5"></TextBlock>
                            <TextBlock Text="11." TextAlignment="Center" Margin="5"></TextBlock>
                            <TextBlock Text="12." TextAlignment="Center" Margin="5"></TextBlock>
                            <TextBlock Text="13." TextAlignment="Center" Margin="5"></TextBlock>
                            <TextBlock Text="14." TextAlignment="Center" Margin="5"></TextBlock>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>
            <Button Grid.Row="1" Grid.ColumnSpan="2" Width="170" Height="30" Margin="15" Background="Aquamarine" Content="Сохранить введённое время" Name="BtnSaveTime" Click="BtnSaveTime_Click"></Button>
        </Grid>
        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="5">
            <TextBlock Text="Статус работы программы" TextAlignment="Center"></TextBlock>
            <TextBlock Margin="0, 5, 0, 0" TextAlignment="Center" Name="TextOption"></TextBlock>
        </StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0, 64, 0, 0">
            <StackPanel Margin="10">
                <TextBlock Text="Основные команды" TextAlignment="Center"></TextBlock>
                <Button Content="Запуск работы" Margin="5" Width="160" Height="30" Background="Aquamarine" Name="BtnStart" Click="BtnStart_Click"></Button>
                <Button Content="Тревога" Width="160" Height="30" Margin="5" Background="Orange" Name="BtnAttention" Click="BtnAttention_Click"></Button>
                <Button Margin="5" Width="160" Height="40" Background="Orange" Name="BtnStop" Click="BtnStop_Click">
                    <TextBlock TextAlignment="Center">Остановить работу<LineBreak/> приложения</TextBlock>
                </Button>
            </StackPanel>
            <StackPanel Margin="10">
                <TextBlock Text="Отладочные команды" TextAlignment="Center"></TextBlock>
                <Button Content="Проверить работу звонка" Margin="5" Width="160" Height="30" Background="Aquamarine" Name="BtnSound" Click="BtnSound_Click"></Button>
                <Button Content="Проверить работу тревоги" Margin="5" Width="160" Height="30" Background="Aquamarine" Name="BtnAttentionSound" Click="BtnAttentionSound_Click"></Button>
                <Button Width="160" Height="60" Margin="5" Background="Orange" Name="BtnStopSoundAll" Click="BtnStopSoundAll_Click">
                    <TextBlock TextAlignment="Center">Остановить<LineBreak/>воспроизведение<LineBreak/> всех звуков</TextBlock>
                </Button>
                <Button Width="160" Height="40" Margin="5" Background="Orange" Name="BtnTimeDefault" Click="BtnTimeDefault_Click">
                    <TextBlock TextAlignment="Center">Установить время<LineBreak/>по умолчанию</TextBlock>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
