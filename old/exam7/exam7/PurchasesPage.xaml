<Page x:Class="exam7.PurchasesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:exam7"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PurchasesPage" IsVisibleChanged="Page_IsVisibleChanged">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
        </Grid.RowDefinitions>
        <DataGrid AutoGenerateColumns="False" x:Name="DGridPurchases" IsReadOnly="True" Background="#F4E8D3">
            <DataGrid.Columns>
                <DataGridTextColumn Width="*" Header="Продукт" Binding="{Binding Products.ProductsName}"></DataGridTextColumn>
                <DataGridTextColumn Width="*" Header="Партнёр" Binding="{Binding Partners.PartnersName}"></DataGridTextColumn>
                <DataGridTextColumn Width="*" Header="Количество продукта" Binding="{Binding PurchasesQuantity}"></DataGridTextColumn>
                <DataGridTextColumn Width="*" Header="Дата" Binding="{Binding PurchasesDate}"></DataGridTextColumn>
                <DataGridTemplateColumn Width="auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Редактировать" Name="BtnEdit" Click="BtnEdit_Click"></Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Button Name="BtnAdd" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center" Content="Добавить" Click="BtnAdd_Click"></Button>
        <Button Name="BtnDelete" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center" Content="Удалить" Click="BtnDelete_Click"></Button>
    </Grid>
</Page>
