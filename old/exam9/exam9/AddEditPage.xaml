<Page x:Class="exam9.AddEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:exam9"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddEditPage">

    <Grid Background="#F4E8D3">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <TextBlock Text="Продукт" Grid.Row="0" Grid.Column="0"></TextBlock>
        <TextBlock Text="Партнёр" Grid.Row="1" Grid.Column="0"></TextBlock>
        <TextBlock Text="Количество продукта" Grid.Row="2" Grid.Column="0"></TextBlock>
        <TextBlock Text="Дата" Grid.Row="3" Grid.Column="0"></TextBlock>
        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ComboProducts" SelectedItem="{Binding Products}" DisplayMemberPath="ProductsName"></ComboBox>
        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="ComboPartners" SelectedItem="{Binding Partners}" DisplayMemberPath="PartnersName"></ComboBox>
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PurchasesQuantity}"></TextBox>
        <DatePicker Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" SelectedDate="{Binding PurchasesDate}"></DatePicker>
        <Button Grid.ColumnSpan="2" Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Сохранить" Name="BtnSave" Click="BtnSave_Click"></Button>
    </Grid>
</Page>
