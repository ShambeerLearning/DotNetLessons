<Page x:Class="exam8.PurchasesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:exam8"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PurchasesPage" IsVisibleChanged="Page_IsVisibleChanged">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
        </Grid.RowDefinitions>
        <DataGrid AutoGenerateColumns="False" IsReadOnly="True" x:Name="DGridPurchases" Background="#F4E8D3">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Продукт" Width="*" Binding="{Binding Products.ProductsName}"></DataGridTextColumn>
                <DataGridTextColumn Header="Партнёр" Width="*" Binding="{Binding Partners.PartnersName}"></DataGridTextColumn>
                <DataGridTextColumn Header="Количество продукта" Width="*" Binding="{Binding PurchasesQuantity}"></DataGridTextColumn>
                <DataGridTextColumn Header="Дата" Width="*" Binding="{Binding PurchasesDate}"></DataGridTextColumn>
                <DataGridTemplateColumn Width="auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Name="BtnEdit" Content="Редактировать" Click="BtnEdit_Click"></Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Button Name="BtnAdd" Content="Добавить" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Left" Click="BtnAdd_Click"></Button>
        <Button Name="BtnDelete" Content="Добавить" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Right" Click="BtnDelete_Click"></Button>
    </Grid>
</Page>
