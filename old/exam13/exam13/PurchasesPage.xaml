<Page x:Class="exam13.PurchasesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:exam13"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PurchasesPage" IsVisibleChanged="Page_IsVisibleChanged">

    <Grid Background="#F4E8D3">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
        </Grid.RowDefinitions>
        <DataGrid Background="#F4E8D3" AutoGenerateColumns="False" IsReadOnly="True" Name="DGridPurchases">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Заказы" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock HorizontalAlignment="Left" TextAlignment="Left">
                                    <Run Text="{Binding Products.ProductsName}"></Run>
                                    <Run Text="|"></Run>
                                    <Run Text="{Binding Partners.PartnersName}"></Run>
                                </TextBlock>
                                <TextBlock HorizontalAlignment="Left" TextAlignment="Left">
                                    <Run Text="{Binding PurchasesQuantity}"></Run>
                                    <Run Text="|"></Run>
                                    <Run Text="{Binding PurchasesDate}"></Run>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Действие">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Редактировать" Name="BtnEdit" Click="BtnEdit_Click"></Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Button Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Left" Content="Добавить" Name="BtnAdd" Click="BtnAdd_Click"></Button>
        <Button Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Right" Content="Удалить" Name="BtnDelete" Click="BtnDelete_Click"></Button>
    </Grid>
</Page>
