<Page x:Class="Exam6.PurchasesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Exam6"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PurchasesPage" IsVisibleChanged="Page_IsVisibleChanged">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
        </Grid.RowDefinitions>
        <DataGrid x:Name="DGridPurchases" AutoGenerateColumns="False" IsReadOnly="True" Background="#F4E8D3">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Продукты" Width="*" Binding="{Binding Products.ProductsName}"></DataGridTextColumn>
                <DataGridTextColumn Header="Партнёры" Width="*" Binding="{Binding Partners.PartnersName}"></DataGridTextColumn>
                <DataGridTextColumn Header="Количество продуктов" Width="*" Binding="{Binding PurchasesQuantity}"></DataGridTextColumn>
                <DataGridTextColumn Header="Дата" Width="*" Binding="{Binding PurchasesDate}"></DataGridTextColumn>
                <DataGridTemplateColumn Width="auto"> 
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Редактировать" Name="BtnEdit" Click="BtnEdit_Click"></Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Button Content="Добавить" Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Center" Name="BtnAdd" Click="BtnAdd_Click"></Button>
        <Button Content="Удалить" Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Center" Name="BtnDelete" Click="BtnDelete_Click"></Button>
    </Grid>
</Page>
